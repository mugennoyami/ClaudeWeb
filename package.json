{
  "name": "coldstart-shop",
  "version": "1.0.0",
  "private": true,
  "description": "COLDSTART – Website, Shop und Admin-Bereich",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
